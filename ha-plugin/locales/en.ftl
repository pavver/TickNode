# English messages; node definitions supply English fallback text.

# Property validation and runtime configuration errors.
home-assistant-error-property-text = The property must be text
home-assistant-error-property-option = Choose an available option
home-assistant-error-signed-duration = Enter a signed duration, for example -30m or 00:30:00
home-assistant-error-duration = Enter a non-negative duration, for example 5m or 00:05:00
home-assistant-error-time = Enter a time as HH:MM or HH:MM:SS
home-assistant-error-weekdays = Choose weekdays from Monday to Sunday
home-assistant-error-event-data = Event data must be a JSON object
home-assistant-error-event-type = Event type must not contain whitespace
home-assistant-error-mqtt-topic = Invalid MQTT topic filter: + must occupy a whole level and # must be the last whole level
home-assistant-error-webhook-id = Webhook ID may contain only letters, digits, underscores and hyphens
home-assistant-error-time-pattern = Use a number, * or /n; hours range from 0 to 23, minutes and seconds from 0 to 59; n must be positive
home-assistant-error-time-at = Enter HH:MM[:SS] or an entity ID such as input_datetime.alarm or sensor.next_alarm
home-assistant-error-entity-id = Enter an entity ID as domain.object_id
home-assistant-error-configuration = Invalid trigger configuration

