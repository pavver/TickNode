/// Contract between the TickNode engine (host, wasmtime) and a node plugin (WASM component).
///
/// A plugin is a set of node types. Each graph node is a separate `node` resource inside the
/// plugin instance, so a node retains its own state across calls. Async work (delays, HTTP)
/// is executed by the host: the plugin receives a `task-id`, and the result arrives later via a `task` trigger.
package ticknode:plugin@0.1.0;

interface types {
    /// Data value — postcard-encoded `ticknode_shared::DataValue`.
    /// WIT has no recursive types, and values can be nested (lists, objects).
    type value = list<u8>;

    variant scalar-type {
        %bool, number, %string, time, datetime, duration, color, object, any,
        /// Custom plugin type by full name (`ha.state`), declared via `types`.
        named(string),
    }

    /// Pin data type: `list-depth = 2`, `base = number` means `list<list<number>>`.
    record data-type {
        base: scalar-type,
        list-depth: u8,
    }

    record field-definition {
        name: string,
        title: string,
        description: string,
        data-type: data-type,
        /// An optional field may be absent from the value.
        optional: bool,
    }

    record enum-value {
        /// The value as passed (`DataValue::String`).
        value: string,
        title: string,
    }

    variant type-kind {
        /// Struct: value is a `DataValue::Object` with a type tag.
        structure(list<field-definition>),
        /// Enum: value is a `DataValue::String` from the enumeration.
        enumeration(list<enum-value>),
    }

    /// Custom plugin data type.
    record type-definition {
        /// Full dotted name, e.g. `ha.state`.
        name: string,
        title: string,
        description: string,
        /// `#rrggbb` — color of pins and wires in the editor.
        color: option<string>,
        kind: type-kind,
    }

    variant pin-type {
        exec,
        data(data-type),
    }

    enum pin-direction { input, output }

    record pin {
        id: u32,
        name: string,
        pin-type: pin-type,
        direction: pin-direction,
        /// Required input: without a connection or value on the node, the host does not call `execute`.
        required: bool,
    }

    variant property-kind {
        /// Free text (the default for properties that are not described).
        text,
        /// Drop-down with static (value, label) options.
        %select(list<tuple<string, string>>),
        /// Searchable picker over the options the plugin publishes at runtime under this source name
        /// (`host.set-options`).
        dynamic(string),
    }

    /// Describes a node property so the editor can show a title, a drop-down or a picker.
    record property-definition {
        name: string,
        title: string,
        description: string,
        kind: property-kind,
    }

    /// One option of a dynamic property.
    record property-option {
        /// The value stored in the property.
        value: string,
        /// Primary line.
        label: string,
        /// Secondary line, e.g. the entity id.
        detail: string,
        /// Material Design Icons name, e.g. `mdi:lightbulb`.
        icon: option<string>,
    }

    record node-definition {
        type-name: string,
        title: string,
        category: string,
        description: string,
        /// Detailed explanation of how the node works ("info" tooltip in the editor).
        help: string,
        pins: list<pin>,
        /// Event source node: the host calls `node.poll` every tick. Otherwise `poll` is not called.
        polls: bool,
        /// Properties shown with a title, a drop-down or a picker. Others stay plain text rows.
        properties: list<property-definition>,
        /// Relative work per node call; native logic costs one unit.
        cost: u32,
    }

    variant capability {
        /// HTTP(S) requests to listed domains and their subdomains; `*` — any domain.
        http(list<string>),
        /// Plugin's own directory, accessible via `std::fs` (WASI) as the current working directory.
        storage,
        /// Persistent WebSocket connections (`ws://`, `wss://`) to listed hosts and their subdomains; `*` — any host.
        websocket(list<string>),
    }

    record property {
        name: string,
        value: value,
    }

    variant setting-kind {
        text,
        number,
        %bool,
        /// Token or password: the editor cannot read it back.
        secret,
        url,
        /// (value, label) pairs.
        select(list<tuple<string, string>>),
    }

    /// Plugin setting configured by the user in the UI.
    record setting-definition {
        key: string,
        title: string,
        description: string,
        kind: setting-kind,
        /// Without a value (and without a `default`), the plugin is not considered configured.
        required: bool,
        /// Default value — postcard-encoded `DataValue`.
        default: option<value>,
    }

    record plugin-manifest {
        name: string,
        version: string,
        author: string,
        capabilities: list<capability>,
        settings: list<setting-definition>,
    }

    record http-request {
        method: string,
        url: string,
        headers: list<tuple<string, string>>,
        body: list<u8>,
        /// 0 — default host timeout.
        timeout-ms: u32,
    }

    record http-response {
        status: u16,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }

    type task-id = u64;

    variant task-output {
        delay,
        http(http-response),
    }

    record task-done {
        id: task-id,
        %result: result<task-output, string>,
    }

    /// Handle of a plugin-owned WebSocket connection. Valid only within one plugin instance:
    /// after a crash (instance recreated) all connections are closed and old ids are void.
    type ws-id = u64;

    /// Connection event delivered to `plugin-tick`.
    variant ws-event {
        /// The connection is established.
        opened(ws-id),
        /// A text frame was received.
        message(tuple<ws-id, string>),
        /// The connection ended (or could not be opened); carries the reason.
        closed(tuple<ws-id, string>),
    }

    /// Reason for calling `node.execute`.
    variant trigger {
        /// Pulse on an input exec pin (or manual trigger from the editor).
        pin(u32),
        /// A task previously started by the node has completed.
        task(task-done),
    }

    variant output {
        /// Pulse from an output exec pin (downstream nodes execute on the next tick).
        exec(u32),
        /// New value on an output data pin.
        data(tuple<u32, value>),
        /// Remove the current value from an output data pin.
        clear(u32),
    }

    /// Graph node id: the (high, low) 64-bit halves of its UUID (WIT has no 128-bit integer).
    type node-id = tuple<u64, u64>;

    /// Outputs produced by a node outside of its own `execute`/`poll` (see `plugin-tick`).
    record emission {
        /// Graph node id (as given to `create-node`).
        node: node-id,
        outputs: list<output>,
    }

    enum log-level { debug, info, warn, error }

    /// Translatable message for the user (shown in the UI, e.g. a `configure` error). `key` is a Fluent
    /// message id from the plugin's `translations` (it must start with the plugin name slug, otherwise
    /// the host drops it); `fallback` is the final English text used when the key cannot be resolved.
    record ui-error {
        key: string,
        args: list<tuple<string, string>>,
        fallback: string,
    }
}

/// Host services. Task-starting functions work only during `execute`/`poll`
/// (the task belongs to the currently executing node).
interface host {
    use types.{log-level, task-id, http-request, ws-id, property-option};

    /// Log message to the editor console (on behalf of the current node). Logs are never translated:
    /// always write them in English.
    log: func(level: log-level, message: string);

    /// Current tick number.
    current-tick: func() -> u64;

    /// Tick duration in milliseconds.
    tick-duration-ms: func() -> u32;

    /// Delay for `ticks` ticks; result is `task-output::delay`.
    delay: func(ticks: u64) -> result<task-id, string>;

    /// HTTP request; requires `capability::http` for the domain.
    start-http: func(request: http-request) -> result<task-id, string>;

    /// Cancels a task belonging to this node. `false` if the task no longer exists.
    cancel-task: func(id: task-id) -> bool;

    /// Opens a WebSocket connection owned by the plugin (not by a node); usable from any plugin call.
    /// Requires `capability::websocket` for the host. Returns immediately: the connection is opened
    /// asynchronously and the plugin receives `ws-event::opened` (or `closed` on failure) in `plugin-tick`.
    /// At most 4 connections per plugin.
    ws-connect: func(url: string, headers: list<tuple<string, string>>) -> result<ws-id, string>;

    /// Sends a text frame (max 16 MiB). An error if the connection is unknown or closed.
    ws-send: func(id: ws-id, text: string) -> result<_, string>;

    /// Closes the connection; no `closed` event is delivered for it afterwards.
    ws-close: func(id: ws-id);

    /// Replaces the plugin's options for a dynamic property `source` (see `property-kind.dynamic`).
    /// Usable from any plugin call. The host caps the number of options per source (20 000) and the
    /// length of every string (options violating the limits are dropped and logged); an empty list
    /// removes the source. Unchanged lists are not re-sent to editors.
    set-options: func(source: string, options: list<property-option>);
}

interface nodes {
    use types.{plugin-manifest, node-definition, type-definition, property, value, trigger, output, ui-error, ws-event, emission, node-id};

    manifest: func() -> plugin-manifest;

    /// Applies settings (following the manifest schema; values are saved or defaults). Called by the host
    /// after loading, on every settings change, and after recreating the plugin instance
    /// (crash) — before recreating nodes. `err` is shown to the user (translated via its `key`);
    /// the plugin remains loaded.
    configure: func(settings: list<property>) -> result<_, ui-error>;

    /// Definitions of all node types with default properties.
    definitions: func() -> list<node-definition>;

    /// Custom plugin data types (structs and enums). The host reads them alongside `definitions`.
    types: func() -> list<type-definition>;

    /// Translations shipped by the plugin: `(locale code, Fluent source)` pairs, e.g. `("uk", "...")`.
    /// Definition texts are the English fallback, so an `en` resource is optional. The host validates
    /// the syntax and keeps only messages with the plugin's own id prefixes. The host reads them
    /// alongside `definitions`.
    translations: func() -> list<tuple<string, string>>;

    resource node {
        /// Pins may depend on properties.
        definition: func() -> node-definition;
        properties: func() -> list<property>;
        set-property: func(name: string, value: value);
        /// `inputs` — values of connected input data pins.
        execute: func(trigger: trigger, inputs: list<tuple<u32, value>>) -> list<output>;
        /// For event source nodes: called at the start of every tick.
        poll: func(tick: u64) -> option<u32>;
    }

    /// `node` is the graph node id (UUID halves); the plugin uses it to address `emission`s.
    create-node: func(type-name: string, node: node-id) -> result<node, string>;

    /// Called by the host once per tick for every enabled plugin (even with no events, so the plugin can
    /// drive timers and keep-alives), after finished tasks are delivered and before event sources are
    /// polled. `events` are the WebSocket events since the previous tick (at most 1000 per tick; the rest
    /// stays queued). Returned emissions are applied as if the target node had executed; the host drops
    /// emissions for nodes that do not exist or belong to another plugin, and invalid pins or values.
    plugin-tick: func(events: list<ws-event>) -> list<emission>;
}

world plugin {
    import host;
    export nodes;
}
